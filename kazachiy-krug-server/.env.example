# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kazachiy_krug?schema=public"

# HTTP + Socket.IO port.
PORT=3000

# Comma-separated browser origins. Never use * for a public production service.
CORS_ORIGINS=http://localhost:5173

# Persistent directory for user uploads (mount a host volume here in production).
UPLOAD_DIR=uploads

# Set true only when the app is behind a trusted reverse proxy (for correct HTTPS URLs).
TRUST_PROXY=false

# Keep false for stable DB-backed environments. Enable only for local/dev DB outages.
SOCKET_MEMORY_FALLBACK_ENABLED=false

# Allows call socket memory fallback when DB is unavailable.
CALL_MEMORY_FALLBACK_ENABLED=true

# Existing account that receives administrator credentials. The bootstrap command
# updates this user and never creates a duplicate account.
ADMIN_USER_ID=user-1
ADMIN_LOGIN=kazak
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com

# Public contact shown after a registration request. Keep the real number only in .env.
REGISTRATION_CONTACT_PHONE=+79000000000

# Versions recorded with each separate legal acceptance.
REGISTRATION_TERMS_RULES_VERSION=2026-08-15
REGISTRATION_PERSONAL_DATA_VERSION=2026-08-15
REGISTRATION_PUBLIC_PROFILE_VERSION=2026-08-15
