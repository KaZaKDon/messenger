DirectoryIndex index.html
Options -MultiViews

# Real 404 response for unknown URLs. This prevents SPA fallback from
# turning arbitrary non-existent pages into HTTP 200 (soft 404).
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files and directories are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Public/authenticated React routes that must survive a direct request
    # or browser refresh on shared hosting.
    RewriteRule ^(?:phone|code|chat|settings|my-ads|support-requests|calls|profile)/?$ index.html [L]

    # Current admin routes from src/app/router.jsx.
    RewriteRule ^admin/?$ index.html [L]
    RewriteRule ^admin/(?:overview|groups|advertisements|settlements|complaints|support-requests|payments|moderators)/?$ index.html [L]
    RewriteRule ^admin/users/?$ index.html [L]
    RewriteRule ^admin/users/(?:registrations|password-recoveries)/?$ index.html [L]
    RewriteRule ^admin/registrations/?$ index.html [L]

    # Everything else is genuinely absent. Keep the HTTP status as 404;
    # Apache will render public/404.html through ErrorDocument above.
    RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
